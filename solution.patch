Subject: [PATCH] Solution: parallelStream, screenComplianceBatch, enable
 regression tests

---
 .../main/kotlin/com/workshop/pricing/PricingController.kt   | 6 +++---
 .../main/kotlin/com/workshop/transfer/TransferController.kt | 6 ++----
 .../kotlin/com/workshop/pricing/PricingConcurrencyTest.kt   | 2 --
 .../kotlin/com/workshop/transfer/ComplianceFanoutTest.kt    | 2 --
 4 files changed, 5 insertions(+), 11 deletions(-)

diff --git a/app/src/main/kotlin/com/workshop/pricing/PricingController.kt b/app/src/main/kotlin/com/workshop/pricing/PricingController.kt
index 2d28597..f13a9f5 100644
--- a/app/src/main/kotlin/com/workshop/pricing/PricingController.kt
+++ b/app/src/main/kotlin/com/workshop/pricing/PricingController.kt
@@ -42,9 +42,9 @@ class PricingController(
 
         log.info("Calculating pricing: strategy={} candidates={}", strategy.name, candidates.size)
 
-        val rates = candidates.map { candidate ->
-            fxClient.getRate(request.sourceCurrency, request.targetCurrency, candidate)
-        }
+        val rates = candidates.parallelStream()
+            .map { fxClient.getRate(request.sourceCurrency, request.targetCurrency, it) }
+            .toList()
 
         val best = rates.minByOrNull { it.rate }!!
 
diff --git a/app/src/main/kotlin/com/workshop/transfer/TransferController.kt b/app/src/main/kotlin/com/workshop/transfer/TransferController.kt
index d07f860..d412552 100644
--- a/app/src/main/kotlin/com/workshop/transfer/TransferController.kt
+++ b/app/src/main/kotlin/com/workshop/transfer/TransferController.kt
@@ -39,10 +39,8 @@ class TransferController(
         val limits = supportClient.getLimits(customer.customerId)
         log.info("Limits checked: withinLimit={}", limits.withinLimit)
 
-        customer.beneficiaries.forEachIndexed { index, beneficiary ->
-            val result = supportClient.screenCompliance(beneficiary.id, index)
-            log.info("Compliance cleared: beneficiaryId={} cleared={}", beneficiary.id, result.cleared)
-        }
+        val batchResult = supportClient.screenComplianceBatch(customer.beneficiaries)
+        log.info("Compliance batch cleared: count={}", batchResult.results.size)
 
         val pricing = pricingClient.calculate(
             PricingRequest(request.sourceCurrency, request.targetCurrency, request.transferType, bucket)
