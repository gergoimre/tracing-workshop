Subject: [PATCH] Solution: parallelStream FX, dedupe+filter screening terms,
 enable regression tests

---
 .../main/kotlin/com/workshop/pricing/PricingController.kt   | 6 +++---
 app/src/main/kotlin/com/workshop/risk/RiskController.kt     | 2 ++
 .../kotlin/com/workshop/pricing/PricingConcurrencyTest.kt   | 2 --
 app/src/test/kotlin/com/workshop/risk/RiskScreeningTest.kt  | 2 --
 4 files changed, 5 insertions(+), 7 deletions(-)

diff --git a/app/src/main/kotlin/com/workshop/pricing/PricingController.kt b/app/src/main/kotlin/com/workshop/pricing/PricingController.kt
index 66bc2bd..254f57c 100644
--- a/app/src/main/kotlin/com/workshop/pricing/PricingController.kt
+++ b/app/src/main/kotlin/com/workshop/pricing/PricingController.kt
@@ -58,9 +58,9 @@ class PricingController(
 
         log.info("Calculating pricing: strategy={} candidates={}", strategy.name, candidates.size)
 
-        val rates = candidates.map { candidate ->
-            fxClient.getRate(request.sourceCurrency, request.targetCurrency, candidate)
-        }
+        val rates = candidates.parallelStream()
+            .map { fxClient.getRate(request.sourceCurrency, request.targetCurrency, it) }
+            .toList()
 
         val best = rates.minByOrNull { it.rate }!!
 
diff --git a/app/src/main/kotlin/com/workshop/risk/RiskController.kt b/app/src/main/kotlin/com/workshop/risk/RiskController.kt
index 0006bb2..8b4fc30 100644
--- a/app/src/main/kotlin/com/workshop/risk/RiskController.kt
+++ b/app/src/main/kotlin/com/workshop/risk/RiskController.kt
@@ -55,6 +55,8 @@ class RiskController(
         val terms = memo.split(",")
             .flatMap { it.split(" ") }
             .map { it.trim().lowercase() }
+            .filter { it.isNotBlank() }
+            .distinct()
 
         terms.forEach { term ->
             val result = screeningClient.check(term, customerId)
