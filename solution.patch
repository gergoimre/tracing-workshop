Date: Tue, 22 Sep 2026 19:54:35 +0200
Subject: [PATCH] Solution: parallelStream FX, fix cache key (remove
 requestId), enable regression tests

---
 .../kotlin/com/workshop/pricing/PricingController.kt  |  6 +++---
 .../main/kotlin/com/workshop/pricing/RouteCache.kt    | 11 +++++------
 .../com/workshop/pricing/PricingConcurrencyTest.kt    |  2 --
 .../kotlin/com/workshop/pricing/RouteCacheTest.kt     |  2 --
 4 files changed, 8 insertions(+), 13 deletions(-)

diff --git a/app/src/main/kotlin/com/workshop/pricing/PricingController.kt b/app/src/main/kotlin/com/workshop/pricing/PricingController.kt
index b94974a..b08750a 100644
--- a/app/src/main/kotlin/com/workshop/pricing/PricingController.kt
+++ b/app/src/main/kotlin/com/workshop/pricing/PricingController.kt
@@ -57,9 +57,9 @@ class PricingController(
 
         log.info("Calculating pricing: strategy={} candidates={}", strategy.name, candidates.size)
 
-        val rates = candidates.map { candidate ->
-            fxClient.getRate(request.sourceCurrency, request.targetCurrency, candidate)
-        }
+        val rates = candidates.parallelStream()
+            .map { fxClient.getRate(request.sourceCurrency, request.targetCurrency, it) }
+            .toList()
 
         val best = rates.minByOrNull { it.rate }!!
 
diff --git a/app/src/main/kotlin/com/workshop/pricing/RouteCache.kt b/app/src/main/kotlin/com/workshop/pricing/RouteCache.kt
index 569abd7..d0acdcb 100644
--- a/app/src/main/kotlin/com/workshop/pricing/RouteCache.kt
+++ b/app/src/main/kotlin/com/workshop/pricing/RouteCache.kt
@@ -12,8 +12,7 @@ class RouteCache {
         val sourceCurrency: String,
         val targetCurrency: String,
         val transferType: String,
-        val amountBucket: String,
-        val requestId: String
+        val amountBucket: String
     )
 
     private val store = ConcurrentHashMap<CacheKey, List<com.workshop.common.RouteCandidate>>()
@@ -23,18 +22,18 @@ class RouteCache {
         targetCurrency: String,
         transferType: String,
         amountBucket: String,
-        requestId: String
+        requestId: String = ""
     ): List<com.workshop.common.RouteCandidate>? =
-        store[CacheKey(sourceCurrency, targetCurrency, transferType, amountBucket, requestId)]
+        store[CacheKey(sourceCurrency, targetCurrency, transferType, amountBucket)]
 
     fun put(
         sourceCurrency: String,
         targetCurrency: String,
         transferType: String,
         amountBucket: String,
-        requestId: String,
+        requestId: String = "",
         candidates: List<com.workshop.common.RouteCandidate>
     ) {
-        store[CacheKey(sourceCurrency, targetCurrency, transferType, amountBucket, requestId)] = candidates
+        store[CacheKey(sourceCurrency, targetCurrency, transferType, amountBucket)] = candidates
     }
 }
